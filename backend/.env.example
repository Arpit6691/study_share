PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studyshare
JWT_SECRET=your_jwt_secret_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Email service configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Gemini AI Configuration for Document Validation
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_DOCUMENT_DOMAIN=academic

# Cloudinary — Cloud file storage (required for Vercel / any serverless deployment)
# Sign up free at https://cloudinary.com and get credentials from the Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
